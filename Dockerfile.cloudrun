FROM node:22-alpine AS frontend-build

WORKDIR /frontend

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBUG=False \
    HOST=0.0.0.0 \
    PORT=8080 \
    FRONTEND_DIST_DIR=/app/frontend/dist

WORKDIR /app

COPY requirements.txt .
RUN python -m pip install --no-cache-dir --timeout 120 --retries 5 -r requirements.txt

COPY app ./app
COPY data/PRD_template ./data/PRD_template
COPY data/ic_substrate ./data/ic_substrate
COPY run.py .
COPY --from=frontend-build /frontend/dist ./frontend/dist

RUN mkdir -p /app/data/prd_docs /app/data/design_docs /app/recordings

EXPOSE 8080

CMD ["python", "run.py"]

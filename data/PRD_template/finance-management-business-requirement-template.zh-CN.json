  "example_structured_requirement_model": {
    "document_info": {
      "project_name": "财务管理平台",
      "requirement_name": "财务管理业务需求模板"
    },
    "background": {
      "summary": "当前公司财务流程分散在 Excel、邮件、ERP 和人工审批中，存在数据不统一、审批效率低和预算控制滞后等问题，需要建设统一的财务管理能力。",
      "objective": "建立统一的财务业务入口，提升审批和付款效率，实现预算全过程控制，并满足审计留痕要求。"
    },
    "scope": {
      "in_scope": [
        "费用申请",
        "报销审批",
        "发票上传与校验",
        "预算占用与控制",
        "付款申请与跟踪",
        "财务台账与统计报表"
      ],
      "out_of_scope": [
        "总账核算",
        "税务申报",
        "银行直联",
        "合并报表"
      ]
    },
    "users_and_scenarios": {
      "target_users": [
        "员工",
        "部门负责人",
        "财务专员",
        "财务主管",
        "管理层",
        "系统管理员"
      ],
      "core_scenarios": [
        "员工发起费用或付款申请并查看处理进度",
        "负责人执行业务审批并确认预算合理性",
        "财务审核单据、发票和合同附件",
        "审核通过后进入付款流程并记录付款结果",
        "业务数据进入台账和报表供分析与审计使用"
      ]
    },
    "functional_requirements": {
      "overview": "本次需求围绕申请、审批、预算控制、票据管理、付款管理和报表分析六大能力展开，目标是打通财务业务处理链路。",
      "feature_details": [
        {
          "feature_name": "申请管理",
          "description": "支持费用申请、报销申请和付款申请的发起、保存草稿、提交、撤回与复制。",
          "trigger": "用户点击新建申请并提交。",
          "processing_logic": "系统校验必填字段、金额格式和附件完整性，生成申请单编号并进入后续流程。",
          "inputs": [
            "申请类型",
            "所属部门",
            "费用类别",
            "金额",
            "项目/合同/供应商信息",
            "附件"
          ],
          "outputs": [
            "申请单据",
            "申请状态",
            "操作记录"
          ],
          "exception_cases": [
            "必填项缺失",
            "金额格式错误",
            "附件未上传"
          ]
        },
        {
          "feature_name": "审批管理",
          "description": "支持多级审批、会签、加签、驳回和超时提醒。",
          "trigger": "申请单提交后自动进入审批流。",
          "processing_logic": "按照组织架构和审批规则流转，审批结果驱动单据状态变化。",
          "inputs": [
            "审批节点配置",
            "审批意见",
            "审批结果"
          ],
          "outputs": [
            "审批记录",
            "流程状态",
            "消息提醒"
          ],
          "exception_cases": [
            "审批人缺失",
            "审批超时",
            "流程配置异常"
          ]
        },
        {
          "feature_name": "预算控制",
          "description": "在申请和审核阶段进行预算校验、占用、释放和预警。",
          "trigger": "提交申请或财务审核时触发。",
          "processing_logic": "系统按部门、项目和费用类别校验预算余额，超预算时进入特殊审批或预警流程。",
          "inputs": [
            "预算维度",
            "预算金额",
            "当前申请金额"
          ],
          "outputs": [
            "预算校验结果",
            "预算占用记录",
            "预算预警信息"
          ],
          "exception_cases": [
            "预算未配置",
            "预算余额不足",
            "预算维度不匹配"
          ]
        },
        {
          "feature_name": "发票与单据管理",
          "description": "支持发票信息录入、附件上传、查重和单据关联。",
          "trigger": "用户上传票据或财务审核单据时触发。",
          "processing_logic": "系统校验票据完整性和一致性，维护票据状态并与申请单据关联。",
          "inputs": [
            "发票号码",
            "发票金额",
            "开票日期",
            "附件文件",
            "关联合同编号"
          ],
          "outputs": [
            "票据记录",
            "查重结果",
            "审核状态"
          ],
          "exception_cases": [
            "重复发票",
            "发票信息与申请金额不一致",
            "票据附件损坏或缺失"
          ]
        },
        {
          "feature_name": "付款管理",
          "description": "支持付款审核、付款执行、状态回写和凭证留档。",
          "trigger": "财务审核通过后进入付款处理。",
          "processing_logic": "系统校验收款方信息和付款条件，记录付款状态并归档付款凭证。",
          "inputs": [
            "收款方信息",
            "付款金额",
            "付款账户",
            "付款备注"
          ],
          "outputs": [
            "付款单",
            "付款状态",
            "付款凭证"
          ],
          "exception_cases": [
            "收款方信息缺失",
            "付款失败",
            "重复付款风险"
          ]
        },
        {
          "feature_name": "报表与统计",
          "description": "提供费用、预算和付款等维度的报表查询与导出。",
          "trigger": "用户查询报表或系统定时汇总时触发。",
          "processing_logic": "支持多维度筛选、汇总展示和导出，服务于财务分析与管理决策。",
          "inputs": [
            "查询条件",
            "统计维度",
            "时间范围"
          ],
          "outputs": [
            "费用统计报表",
            "预算执行报表",
            "付款进度报表"
          ],
          "exception_cases": [
            "数据缺失",
            "口径不一致",
            "导出失败"
          ]
        }
      ]
    },
    "business_rules": [
      "每笔申请必须关联费用类别、所属部门和发生日期等基础信息。",
      "超预算申请不可直接通过，需进入特殊审批或强提醒流程。",
      "发票、合同和付款凭证需与申请单据关联存档。",
      "审批通过后方可进入财务审核，财务审核通过后方可进入付款。",
      "同一业务申请不可重复提交付款。",
      "付款完成后单据状态需自动更新为已付款。"
    ],
    "page_and_interaction": {
      "pages": [
        {
          "page_name": "申请单列表",
          "entry_point": "财务管理首页 / 我的申请",
          "page_elements": [
            "筛选区",
            "申请列表",
            "状态标签",
            "导出按钮"
          ],
          "button_actions": [
            "新建申请",
            "查看详情",
            "撤回",
            "导出"
          ]
        },
        {
          "page_name": "申请单详情",
          "entry_point": "申请单列表点击进入",
          "page_elements": [
            "基础信息",
            "费用明细",
            "附件区",
            "审批记录",
            "预算校验结果"
          ],
          "button_actions": [
            "提交",
            "保存草稿",

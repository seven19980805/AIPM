            "转交",
            "加签"
          ]
        },
        {
          "page_name": "付款处理页",
          "entry_point": "财务工作台 / 待付款",
          "page_elements": [
            "付款信息",
            "收款方信息",
            "凭证上传区",
            "付款状态"
          ],
          "button_actions": [
            "确认付款",
            "上传凭证",
            "标记失败"
          ]
        },
        {
          "page_name": "财务报表页",
          "entry_point": "财务分析 / 报表中心",

    {"section_key": "users", "section_title": "用户与负责人", "sort_order": 2, "fields": [{"field_key": "users.primary"}]},
    {"section_key": "scope", "section_title": "首版范围", "sort_order": 3, "fields": [{"field_key": "scope.boundary"}]},
    {"section_key": "workflow", "section_title": "业务流程", "sort_order": 4, "fields": [{"field_key": "workflow.primary"}]},
    {"section_key": "rules", "section_title": "业务规则", "sort_order": 5, "fields": [{"field_key": "rules.confirmed"}]},
    {"section_key": "data", "section_title": "数据边界", "sort_order": 6, "fields": [{"field_key": "data.source"}]},
    {"section_key": "acceptance", "section_title": "验收证据", "sort_order": 7, "fields": [{"field_key": "acceptance.evidence"}]}

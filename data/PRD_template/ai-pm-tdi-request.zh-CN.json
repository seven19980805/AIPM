  "prompt_questions": [
    {"key": "scenario", "question": "首先要改善哪个 TDI request 或 case 动作？"},
    {"key": "owner", "question": "每次交接和最终关闭分别由谁负责？"},
    {"key": "scope", "question": "最小可用首版是什么？"},
    {"key": "rule", "question": "哪个状态、审批或 SLA 规则是硬约束？"},
    {"key": "acceptance", "question": "什么验证证据可以关闭 case？"}

  "example_model": {
    "document_info": {
      "project_name": "培训系统升级项目",
      "requirement_name": "企业培训平台建设"
    },
    "template_meta": {
      "template_name": "培训系统业务需求模板",
      "requirement_type": "新建",
      "priority": "高",
      "proposing_department": "人力资源部 / 培训发展中心",
      "requester": "培训管理员",
      "request_date": "2026-05-11",
      "version": "V1.0"
    },
    "business_background": {
      "summary": "培训计划、课程报名、学习记录、考试成绩和证书目前分散在邮件、表格和多个平台中。培训管理员难以追踪执行进度，学员缺少统一学习入口，管理层缺少可分析的培训效果数据。",
      "pain_points": [
        "培训计划发布和报名依赖人工通知",
        "课程资源分散，学习进度难以统一跟踪",
        "考试结果、证书和培训档案无法自动沉淀",
        "培训数据口径不统一，报表统计耗时"
      ]
    },
    "business_objectives": {
      "objectives": [
        "建立统一的培训计划、课程和学习入口",
        "支持报名、学习、考试、证书的闭环管理",
        "提升培训执行效率和学习记录准确性",
        "沉淀可分析的培训数据，支撑人才发展决策"
      ],
      "metrics": [
        "课程报名处理时长降低 50%",
        "学习完成统计准确率达到 98%",
        "90% 的证书自动生成并归档",
        "培训报表人工整理工作量降低 60%"
      ]
    },
    "business_scope": {
      "in_scope": [
        "课程与课件管理",
        "培训计划发布",
        "学员报名与审批",
        "在线学习与进度跟踪",
        "考试测评与成绩管理",
        "证书与培训档案",
        "培训报表分析"
      ],
      "out_scope": [
        "直播课堂底层能力自研",
        "复杂 LMS 商城化交易",
        "外部大学平台深度内容采购",
        "AI 个性化学习路径推荐"
      ]
    },
    "roles_and_scenarios": {
      "target_roles": [
        "学员：查看课程、报名培训、学习课程、参加考试并查看证书",
        "讲师：维护授课资料、查看学员名单和培训反馈",
        "培训管理员：创建培训计划、管理报名、配置考试和证书",
        "部门负责人：审批团队报名并查看团队学习进度",
        "管理层：查看培训覆盖率、完成率和效果统计",
        "系统管理员：维护权限、分类、字典和基础配置"
      ],
      "core_scenarios": [
        "培训管理员发布培训计划并开放报名范围。",
        "学员在培训门户选择课程、提交报名并接收通知。",
        "部门负责人审批团队成员报名，系统更新报名状态。",
        "学员完成线上学习并参加考试测评。",
        "系统根据完成条件生成证书并沉淀培训档案。",
        "管理层查看培训完成率、考试通过率和课程反馈。"
      ]
    },
    "functional_requirements": {
      "overview": "本需求围绕课程资源、培训计划、报名审批、学习进度、考试测评、证书档案和数据报表七类能力展开，目标是形成培训业务闭环。",
      "features": [
        {
          "feature": "课程与课件管理",
          "description": "维护课程分类、课程信息、课件资料、讲师信息和适用对象。",
          "trigger": "培训管理员创建或更新课程。",
          "logic": [
            "支持课程上下架、分类、标签和适用岗位维护",
            "支持课件、视频、文档、作业等资源关联",
            "支持课程版本和更新记录"
          ],
          "inputs": "课程名称、分类、讲师、课件、适用对象",
          "outputs": "课程详情、课程目录、课件列表",
          "exceptions": "课程重复、课件缺失、课程已被计划引用时限制删除"
        },
        {
          "feature": "培训计划与报名审批",
          "description": "发布培训计划并管理报名、审批、名额和通知。",
          "trigger": "培训计划创建或报名提交。",
          "logic": [
            "支持按组织、岗位、人员范围开放报名",
            "支持名额控制、候补、取消报名和审批流",
            "支持报名通知、审批通知和开课提醒"
          ],
          "inputs": "计划名称、课程、时间、名额、报名范围、审批人",
          "outputs": "培训计划、报名名单、审批结果",
          "exceptions": "名额不足、报名截止、重复报名、审批超时"
        },
        {
          "feature": "在线学习与进度跟踪",
          "description": "为学员提供统一学习入口并记录学习进度。",
          "trigger": "学员进入课程学习。",
          "logic": [
            "支持课程目录、学习进度、学习时长和完成状态记录",
            "支持断点续学、必修课和选修课标识",
            "支持学习提醒和未完成催办"
          ],
          "inputs": "学员、课程、课件、学习时长、完成状态",
          "outputs": "学习记录、进度统计、完成证明",
          "exceptions": "课件无法播放、进度上报失败、重复学习记录合并"
        },
        {
          "feature": "考试测评与成绩管理",
          "description": "配置题库、试卷、考试安排、阅卷和成绩统计。",
          "trigger": "培训计划要求考试或管理员发布考试。",
          "logic": [
            "支持题库、试卷、考试时间、通过分数配置",
            "支持自动阅卷、人工阅卷和补考",
            "支持成绩查询、通过率统计和成绩导出"
          ],
          "inputs": "题目、试卷、考试安排、答题记录",
          "outputs": "成绩单、通过状态、考试统计",
          "exceptions": "考试超时、重复提交、作弊标记、补考资格不足"
        },
        {
          "feature": "证书与培训档案",
          "description": "根据学习完成和考试结果生成证书，并形成员工培训档案。",
          "trigger": "学员满足证书发放条件。",
          "logic": [
            "支持证书模板、编号规则和有效期配置",
            "支持证书生成、下载、撤销和过期提醒",
            "支持按员工聚合培训记录和证书记录"
          ],
          "inputs": "完成记录、成绩、证书模板、员工信息",
          "outputs": "证书、培训档案、证书台账",
          "exceptions": "证书生成失败、证书过期、撤销记录留痕"
        },
        {
          "feature": "培训报表与分析",
          "description": "提供培训执行、学习效果和资源使用情况统计。",
          "trigger": "管理者或培训管理员查看报表。",
          "logic": [
            "支持按组织、课程、时间、岗位统计覆盖率和完成率",
            "支持考试通过率、课程评分、反馈汇总",
            "支持报表导出和定时推送"
          ],
          "inputs": "报名记录、学习记录、考试成绩、反馈数据",
          "outputs": "培训看板、统计报表、导出文件",
          "exceptions": "数据延迟、权限不足、统计口径变更需提示"
        }
      ]
    },
    "page_and_process": {
      "pages": [
        {
          "page": "培训门户首页",
          "entry": "学员端入口",
          "elements": "推荐课程、待学习任务、证书、通知",
          "actions": "搜索课程、报名、继续学习、查看证书",
          "flow": "学员登录后进入门户，查看待办并进入课程。"
        },
        {
          "page": "课程管理",
          "entry": "培训管理员后台",
          "elements": "课程列表、课程详情、课件、讲师、适用对象",
          "actions": "新增课程、编辑课件、上下架、复制课程",
          "flow": "管理员维护课程后发布到可见范围。"
        },
        {
          "page": "培训计划管理",
          "entry": "培训管理员后台",
          "elements": "计划列表、报名名单、审批状态、通知记录",
          "actions": "发布计划、调整名额、查看报名、导出名单",
          "flow": "管理员创建计划，系统按范围开放报名并触发通知。"
        },
        {
          "page": "考试与证书管理",
          "entry": "培训管理员后台",
          "elements": "题库、试卷、考试安排、成绩、证书模板",
          "actions": "配置考试、阅卷、生成证书、撤销证书",
          "flow": "考试结束后系统汇总成绩并按规则生成证书。"
        },
        {
          "page": "培训数据看板",
          "entry": "管理端入口",
          "elements": "覆盖率、完成率、通过率、课程评分、趋势图",
          "actions": "筛选、钻取、导出、订阅",
          "flow": "管理者按组织和时间查看培训效果。"
        }
      ]
    },
    "business_rules_and_data": {
      "rules": [
        "报名截止后默认不允许新增报名，管理员可按权限补录。",
        "同一学员同一培训计划只能存在一条有效报名记录。",
        "课程完成条件可由学习进度、学习时长、作业提交和考试通过共同决定。",
        "证书编号需全局唯一，撤销后不可复用。",
        "涉及成绩和证书的数据修改必须保留审计日志。"
      ],
      "key_data": [
        "课程：课程编号、名称、分类、讲师、课件、适用对象、状态",

    "background": {
      "summary": "采购申请目前依赖邮件、表格和线下签核。申请人难以查看审批状态，审批人缺少统一待办入口，财务审计时也难以追溯完整审批依据。",
      "objective": "建立标准化的线上采购申请审批流程，提升审批透明度，缩短流转周期，并保留完整审计记录。"
    },
    "scope": {
      "in_scope": [
        "采购申请提交",
        "预算与金额校验",
        "多级审批流转",
        "审批通知与催办",
        "流程历史与审计导出"
      ],
      "out_of_scope": [
        "不替代 ERP 的采购订单创建",
        "不覆盖供应商准入流程"

  "sections": [
    {
      "section_key": "document_info",
      "section_title": "基础文档信息",
      "sort_order": 1,
      "fields": [
        {
          "field_key": "document_info.document_name",
          "label": "文档名称",
          "component": "input",
          "data_type": "string",
          "required": true,
          "placeholder": "例如：D.CHQ.QDM 业务流程需求"
        },
        {
          "field_key": "document_info.process_name",
          "label": "业务流程名称",
          "component": "input",
          "data_type": "string",
          "required": true,
          "placeholder": "请输入业务流程名称"
        },
        {
          "field_key": "document_info.owner",
          "label": "业务负责人",
          "component": "input",
          "data_type": "string",
          "required": true,
          "placeholder": "请输入业务负责人"
        },
        {
          "field_key": "document_info.status",
          "label": "文档状态",
          "component": "select",
          "data_type": "string",
          "required": false,
          "options": [
            "草稿",
            "评审中",
            "已批准"
          ]
        }
      ]
    },
    {
      "section_key": "background_objectives",
      "section_title": "背景与目标",
      "sort_order": 2,
      "fields": [
        {
          "field_key": "background_objectives.background",
          "label": "背景说明",
          "component": "textarea",
          "data_type": "string",
          "required": true,
          "placeholder": "描述当前流程背景、痛点和系统化支持原因"
        },
        {
          "field_key": "background_objectives.objectives",
          "label": "目标",
          "component": "list",
          "data_type": "array",
          "required": true,
          "placeholder": "定义期望达成的业务结果"
        }
      ]
    },
    {
      "section_key": "scope",
      "section_title": "范围",
      "sort_order": 3,
      "fields": [
        {
          "field_key": "scope.in_scope",
          "label": "本次范围",
          "component": "list",
          "data_type": "array",
          "required": true,
          "placeholder": "列出流程、数据、页面、报表和配置范围"
        },
        {
          "field_key": "scope.out_of_scope",
          "label": "非本次范围",
          "component": "list",
          "data_type": "array",
          "required": false,
          "placeholder": "列出本次明确不包含的内容"
        }
      ]
    },
    {
      "section_key": "stakeholders",
      "section_title": "责任方与干系人",
      "sort_order": 4,
      "fields": [
        {
          "field_key": "stakeholders.roles",
          "label": "干系人角色",
          "component": "table",
          "data_type": "array",
          "required": true,
          "placeholder": "业务发起人、业务负责人、操作人、IT、数据、QA、安全"
        }
      ]
    },
    {
      "section_key": "data_description",
      "section_title": "数据说明",
      "sort_order": 5,
      "fields": [
        {
          "field_key": "data_description.sources",
          "label": "数据来源",
          "component": "table",
          "data_type": "array",
          "required": true,

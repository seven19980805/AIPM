      "requirement_name": "员工生命周期管理优化"
    },
    "background": {
      "summary": "员工档案、招聘入职、考勤排班、薪资输入、绩效记录和培训数据分散在多个工具和表格中，HR 难以形成统一员工视图。",
      "objective": "建设统一的 HR 生命周期工作台，提高数据准确性，自动化跨角色交接，并支持管理层报表分析。"
    },
    "scope": {
      "in_scope": [
        "员工档案管理",
        "入职流程跟踪",

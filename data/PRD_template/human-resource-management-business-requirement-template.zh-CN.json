    },
    "background": {
      "summary": "当前人事流程分散在表格、邮件、线下审批和多个系统中，员工信息口径不一致，招聘入职效率低，考勤薪酬与绩效数据难以联动。",
      "objective": "建立统一的人力资源业务入口，覆盖员工全生命周期，提升流程效率、数据准确性和管理透明度。"
    },
    "scope": {
      "in_scope": [
        "员工档案管理",
        "招聘与入职",
        "考勤与请假",
        "薪酬绩效协同",
        "培训发展记录",
        "组织权限管理"
      ],
      "out_of_scope": [
        "复杂薪资核算引擎",

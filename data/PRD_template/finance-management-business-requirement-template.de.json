  "example_structured_requirement_model": {
    "document_info": {
      "project_name": "Finanzmanagement-Plattform",
      "requirement_name": "Vorlage fuer fachliche Anforderungen im Finanzmanagement"
    },
    "background": {
      "summary": "Aktuelle Finanzablaeufe sind ueber Excel, E-Mail, ERP und manuelle Genehmigungen verteilt. Dadurch entstehen uneinheitliche Daten, geringe Genehmigungseffizienz und verspaetete Budgetkontrolle.",
      "objective": "Einheitlichen Einstieg fuer Finanzprozesse schaffen, Genehmigungs- und Zahlungseffizienz verbessern, End-to-End-Budgetkontrolle ermoeglichen und Audit-Nachvollziehbarkeit erfuellen."
    },
    "scope": {
      "in_scope": [
        "Spesenantraege",
        "Abrechnungsfreigabe",
        "Rechnungsupload und Validierung",
        "Budgetreservierung und Kontrolle",
        "Zahlungsantraege und Nachverfolgung",
        "Finanzbuch und Reporting"
      ],
      "out_of_scope": [
        "Hauptbuchhaltung",
        "Steuererklaerung",
        "Direkte Bankanbindung",
        "Konsolidierte Berichte"
      ]
    },
    "users_and_scenarios": {
      "target_users": [
        "Mitarbeitende",
        "Abteilungsverantwortliche",
        "Finanzspezialisten",
        "Finanzmanager",
        "Management",
        "Systemadministratoren"
      ],
      "core_scenarios": [
        "Mitarbeitende starten Ausgaben- oder Zahlungsantraege und verfolgen den Status.",
        "Abteilungsverantwortliche genehmigen Antraege und bestaetigen das Budget.",
        "Finance prueft Belege, Rechnungen und Vertragsanhaenge.",
        "Freigegebene Antraege gehen in Zahlung und Zahlungsergebnisse werden dokumentiert.",
        "Daten fliessen in Ledger und Berichte fuer Analyse und Audit."
      ]
    },
    "functional_requirements": {
      "overview": "Die Anforderung umfasst Antragstellung, Genehmigung, Budgetkontrolle, Rechnungs-/Belegmanagement, Zahlungsmanagement und Reporting.",
      "feature_details": [
        {
          "feature_name": "Antragsmanagement",
          "description": "Unterstuetzt Einleitung, Entwurfsspeicherung, Einreichung, Rueckzug und Kopie von Spesen-, Abrechnungs- und Zahlungsantraegen.",
          "trigger": "Nutzer klickt auf Neuer Antrag und reicht das Formular ein.",
          "processing_logic": "Das System prueft Pflichtfelder, Betragsformat und Vollstaendigkeit von Anhaengen, erzeugt eine Antragsnummer und leitet den Antrag weiter.",
          "inputs": [
            "Antragstyp",
            "Abteilung",
            "Kostenkategorie",
            "Betrag",
            "Projekt-/Vertrags-/Lieferanteninformationen",
            "Anhaenge"
          ],
          "outputs": [
            "Antragsformular",
            "Antragsstatus",
            "Vorgangsprotokoll"
          ],
          "exception_cases": [
            "Pflichtfelder fehlen",
            "Betragsformat ist ungueltig",
            "Anhaenge fehlen"
          ]
        },
        {
          "feature_name": "Genehmigungsmanagement",
          "description": "Unterstuetzt mehrstufige Genehmigung, Mitzeichnung, Zusatzfreigabe, Ablehnung und Timeout-Erinnerungen.",
          "trigger": "Nach Einreichung gelangt der Antrag automatisch in den Genehmigungsfluss.",
          "processing_logic": "Das System routet nach Organisationsstruktur und Genehmigungsregeln; Ergebnisse steuern Statusaenderungen.",
          "inputs": [
            "Genehmigungsknotenkonfiguration",
            "Genehmigungskommentar",
            "Genehmigungsergebnis"
          ],
          "outputs": [
            "Genehmigungsprotokoll",
            "Workflow-Status",
            "Benachrichtigungen"
          ],
          "exception_cases": [
            "Genehmiger fehlt",
            "Genehmigung ist ueberfaellig",
            "Workflow-Konfiguration ist fehlerhaft"
          ]
        },
        {
          "feature_name": "Budgetkontrolle",
          "description": "Fuehrt Budgetpruefung, Reservierung, Freigabe und Warnung in Antragstellung und Finanzpruefung aus.",
          "trigger": "Bei Einreichung eines Antrags oder bei Finanzpruefung.",
          "processing_logic": "Das System prueft Budgetsaldo nach Abteilung, Projekt und Kostenkategorie; Ueberschreitungen gehen in Sonderfreigabe oder Warnprozess.",
          "inputs": [
            "Budgetdimension",
            "Budgetbetrag",
            "Aktueller Antragsbetrag"
          ],
          "outputs": [
            "Budgetpruefergebnis",
            "Budgetreservierung",
            "Budgetwarnung"
          ],
          "exception_cases": [
            "Budget nicht konfiguriert",
            "Budgetsaldo unzureichend",
            "Budgetdimension passt nicht"
          ]
        },
        {
          "feature_name": "Rechnungs- und Belegmanagement",
          "description": "Unterstuetzt Rechnungserfassung, Anhang-Upload, Dublettenpruefung und Belegverknuepfung.",
          "trigger": "Beim Upload von Belegen oder bei Finanzpruefung.",
          "processing_logic": "Das System prueft Vollstaendigkeit und Konsistenz von Belegen, pflegt Belegstatus und verknuepft Belege mit Antraegen.",
          "inputs": [
            "Rechnungsnummer",
            "Rechnungsbetrag",
            "Ausstellungsdatum",
            "Anhangdatei",
            "Zugehoerige Vertragsnummer"
          ],
          "outputs": [
            "Belegdatensatz",
            "Dublettenpruefergebnis",
            "Pruefstatus"
          ],
          "exception_cases": [
            "Doppelte Rechnung",
            "Rechnungsbetrag passt nicht zum Antrag",
            "Beleganhang ist defekt oder fehlt"
          ]
        },
        {
          "feature_name": "Zahlungsmanagement",
          "description": "Unterstuetzt Zahlungspruefung, Zahlungsausfuehrung, Statusrueckschreibung und Belegarchivierung.",
          "trigger": "Startet nach bestandener Finanzpruefung.",
          "processing_logic": "Das System prueft Empfaengerinformationen und Zahlungsbedingungen, dokumentiert Zahlungsstatus und archiviert Zahlungsbelege.",
          "inputs": [
            "Empfaengerinformationen",
            "Zahlungsbetrag",
            "Zahlungskonto",
            "Zahlungsnotiz"
          ],
          "outputs": [
            "Zahlungsauftrag",
            "Zahlungsstatus",
            "Zahlungsbeleg"
          ],
          "exception_cases": [
            "Empfaengerinformationen fehlen",
            "Zahlung fehlgeschlagen",
            "Risiko doppelter Zahlung"
          ]
        },
        {
          "feature_name": "Reporting und Analyse",
          "description": "Bietet Berichtsabfrage und Export nach Ausgaben-, Budget- und Zahlungsdimensionen.",
          "trigger": "Bei Berichtsabfrage durch Nutzer oder geplanten Systemzusammenfassungen.",
          "processing_logic": "Unterstuetzt mehrdimensionale Filterung, Zusammenfassungsanzeigen und Export fuer Finanzanalyse und Managemententscheidungen.",
          "inputs": [
            "Suchbedingungen",
            "Statistikdimensionen",
            "Zeitraum"
          ],
          "outputs": [
            "Ausgabenbericht",
            "Budgetausfuehrungsbericht",
            "Zahlungsfortschrittsbericht"
          ],
          "exception_cases": [
            "Daten fehlen",
            "Definitionen sind uneinheitlich",
            "Export fehlgeschlagen"
          ]
        }
      ]
    },
    "business_rules": [
      "Jeder Antrag muss mit Kostenkategorie, Abteilung und Leistungsdatum verbunden sein.",
      "Budgetueberschreitungen muessen in Sonderfreigabe oder Warnprozess gehen.",
      "Rechnungen, Vertraege und Zahlungsbelege muessen mit Antraegen archiviert werden.",
      "Zahlung startet erst nach bestandener Finanzpruefung.",
      "Derselbe Geschaeftsantrag darf nicht mehrfach zur Zahlung eingereicht werden.",
      "Nach Zahlung muss der Status automatisch auf Bezahlt wechseln."
    ],
    "page_and_interaction": {

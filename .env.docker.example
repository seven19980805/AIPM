# Copy this file to .env.docker on the deployment server.

# Browser entry point for docker-compose. The frontend will be exposed as:
# http://<server-ip>:${WEB_PORT}
WEB_PORT=8080
DOCKER_PLATFORM=linux/amd64

# Optional Go Coding / vibe coding entry.
VITE_GO_CODING_URL=http://localhost:8888

# Backend runtime
HOST=0.0.0.0
PORT=8000
DEBUG=False
SQLITE_DB_PATH=/app/data/rqmd.sqlite3
CORS_ORIGINS=http://localhost:8080

# Internal OpenAI-compatible LLM gateway.
# The backend will call: ${LLM_BASE_URL}/chat/completions
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://your-internal-llm-gateway/v1
LLM_API_KEY=
LLM_MODEL=your-internal-model-name
LLM_TIMEOUT_SECONDS=500
LLM_MAX_RETRIES=2
LLM_DEBUG_STREAM=false

# Optional proxy for model access.
LLM_PROXY_URL=

# ASR is optional.
ASR_APP_ID=
ASR_ACCESS_TOKEN=
ASR_SECRET_KEY=
ASR_BASE_URL=

# Server Configuration
HOST=0.0.0.0
PORT=8000
# DEBUG=True only for local development (Flask dev server). Production runs waitress.
DEBUG=False
# Worker threads used by waitress when DEBUG=False.
WAITRESS_THREADS=8

# CORS Configuration - strict allow-list. Origins not in this list receive no CORS headers.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:9530

# LLM Configuration - app refuses to start if these are missing or invalid.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_DEBUG_STREAM=false
LLM_GCP_PROJECT_ID=
LLM_GCP_LOCATION=global
LLM_GCP_CREDENTIALS_PATH=

# Log Configuration
LOG_LEVEL=INFO
LOG_FILE=app.log

# ASR Configuration
ASR_APP_ID=
ASR_ACCESS_TOKEN=
ASR_SECRET_KEY=
ASR_BASE_URL=

# Database Configuration (if needed)
# DATABASE_URL=postgresql://user:password@localhost:5432/rqmd_db

# Frontend Runtime Configuration (these go in frontend/.env, not the backend .env)
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_GO_CODING_URL=http://localhost:8888
